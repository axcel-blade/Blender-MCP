---
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const installPs1 = `${base}/install.ps1`;
const installSh = `${base}/install.sh`;

const winCmd = `irm https://axcel-blade.github.io/Blender-MCP/install.ps1 | iex`;
const unixCmd = `curl -LsSf https://axcel-blade.github.io/Blender-MCP/install.sh | sh`;
---

<Layout>
  <main class="page">
    <p class="eyebrow">Blender · MCP</p>
    <h1>Blender MCP</h1>
    <p class="lede">
      Connect Claude, Cursor, VS Code, and other MCP clients to a live Blender
      session. One command installs uv, clones the repo, syncs dependencies, and
      installs the addon.
    </p>

    <section class="panel">
      <h2>Windows (PowerShell)</h2>
      <div class="command">
        <pre><code>{winCmd}</code></pre>
        <button class="copy" type="button" data-copy={winCmd}>Copy</button>
      </div>
      <p style="margin: 0.75rem 0 0; color: var(--muted); font-size: 0.95rem;">
        Script URL: <a href={installPs1}>{installPs1}</a>
      </p>
    </section>

    <section class="panel">
      <h2>macOS / Linux</h2>
      <div class="command">
        <pre><code>{unixCmd}</code></pre>
        <button class="copy" type="button" data-copy={unixCmd}>Copy</button>
      </div>
      <p style="margin: 0.75rem 0 0; color: var(--muted); font-size: 0.95rem;">
        Script URL: <a href={installSh}>{installSh}</a>
      </p>
    </section>

    <section class="panel">
      <h2>After install</h2>
      <ol class="steps">
        <li>
          Blender → Edit → Preferences → Add-ons → enable <strong>Blender MCP</strong>
        </li>
        <li>3D Viewport → press <strong>N</strong> → <strong>Blender MCP</strong> → Start</li>
        <li>Fully quit and reopen your MCP client</li>
      </ol>
    </section>

    <nav class="links">
      <a href="https://github.com/axcel-blade/Blender-MCP">GitHub</a>
      <a
        href="https://github.com/axcel-blade/Blender-MCP/blob/develop/docs/INSTALLATION.md"
        >Docs</a
      >
      <a href="https://github.com/axcel-blade/Blender-MCP/blob/develop/SECURITY.md"
        >Security</a
      >
    </nav>
  </main>
</Layout>

<script>
  // navigator.clipboard only exists in secure contexts (HTTPS / localhost),
  // so fall back to execCommand when the site is served over plain HTTP.
  async function copyText(value: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        // fall through to the legacy path
      }
    }
    const area = document.createElement("textarea");
    area.value = value;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.top = "0";
    area.style.left = "0";
    area.style.opacity = "0";
    document.body.appendChild(area);
    area.focus();
    area.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    document.body.removeChild(area);
    return ok;
  }

  function selectCommand(button: HTMLButtonElement) {
    const code = button.parentElement?.querySelector("code");
    if (!code) return;
    const range = document.createRange();
    range.selectNodeContents(code);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy ?? "";
      const ok = await copyText(value);
      button.dataset.copied = ok ? "true" : "false";
      button.textContent = ok ? "Copied" : "Press Ctrl+C";
      if (!ok) selectCommand(button);
      window.setTimeout(() => {
        button.dataset.copied = "false";
        button.textContent = "Copy";
      }, 1600);
    });
  });
</script>
