---
import pyproject from "../../../pyproject.toml?raw";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Blender MCP",
  description = "Build, animate and render in Blender by describing it. An MCP server for Claude, Cursor, VS Code and other AI clients.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/axcel-blade/Blender-MCP";
const docs = `${repo}/blob/main/docs`;
// Single source of truth: the package version in pyproject.toml (bumped by release.yml).
const version = `v${pyproject.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? "dev"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="currentColor"></rect>
          <path
            d="M16 7.5 23.5 11.8v8.4L16 24.5l-7.5-4.3v-8.4L16 7.5Zm0 2.3-5.5 3.1 5.5 3.2 5.5-3.2L16 9.8Zm-5.6 4.8v4.6l4.6 2.7v-4.6l-4.6-2.7Zm11.2 0L17 17.3v4.6l4.6-2.7v-4.6Z"
            fill="var(--bg)"></path>
        </svg>
        Blender MCP
      </a>
      <nav aria-label="Main">
        <a href={`${base}/#install`}>Install</a>
        <a href={`${docs}/TOOLS.md`}>Tools</a>
        <a href={`${docs}/INSTALLATION.md`}>Docs</a>
        <a href={`${repo}/releases/latest`} class="pill">{version}</a>
        <a href={repo} aria-label="GitHub repository">GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <span>Blender MCP {version} · MIT License</span>
      <span>Not affiliated with the Blender Foundation. Blender is a trademark of the Blender Foundation.</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --surface: #ffffff;
    --text: #1d1b18;
    --muted: #625d55;
    --line: #e6e1d8;
    --accent: #d9570d;
    --accent-ink: #ffffff;
    --code-bg: #f3f0ea;
    --radius: 10px;
    --max: 1120px;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14130f;
      --surface: #1c1a16;
      --text: #efebe4;
      --muted: #a59f94;
      --line: #2f2c26;
      --accent: #ff8a3d;
      --accent-ink: #1a1208;
      --code-bg: #221f1a;
      color-scheme: dark;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  a {
    color: var(--accent);
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  code,
  pre,
  kbd {
    font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 16px;
    top: 8px;
    background: var(--surface);
    padding: 6px 10px;
    z-index: 10;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }

  .brand svg {
    color: var(--accent);
  }

  .topbar nav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .topbar nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
  }

  .topbar nav a:hover {
    color: var(--text);
  }

  .pill {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px;
    font-variant-numeric: tabular-nums;
  }

  .footer {
    max-width: var(--max);
    margin: 64px auto 0;
    padding: 24px 16px 40px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 14px;
  }
</style>
