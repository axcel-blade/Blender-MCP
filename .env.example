# Blender MCP bridge
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9877
BLENDER_MCP_AUTH_TOKEN=
BLENDER_MCP_CONNECTION_TIMEOUT=5.0
BLENDER_MCP_REQUEST_TIMEOUT=60.0
BLENDER_MCP_SAFE_EXECUTION=true
BLENDER_MCP_SCRIPT_PERMISSION=trusted
BLENDER_MCP_LOG_LEVEL=INFO

# Blender app (open_blender); empty path means auto-detect
BLENDER_MCP_BLENDER_PATH=
BLENDER_MCP_BLENDER_LAUNCH_TIMEOUT=60

# Optional asset providers (never commit real keys)
BLENDER_MCP_SKETCHFAB_API_KEY=
BLENDER_MCP_POLYPIZZA_API_KEY=
BLENDER_MCP_MESHY_API_KEY=
BLENDER_MCP_TRIPO_API_KEY=
BLENDER_MCP_RODIN_API_KEY=
BLENDER_MCP_HUNYUAN_SECRET_ID=
BLENDER_MCP_HUNYUAN_SECRET_KEY=
